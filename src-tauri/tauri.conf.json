{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poltergeist",
  "version": "0.1.0",
  "identifier": "com.cozy.reminder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "character",
        "url": "index.html",
        "width": 240,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Poltergeist",
        "width": 360,
        "height": 480,
        "minWidth": 300,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
