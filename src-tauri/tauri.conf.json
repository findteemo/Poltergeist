{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poltergeist",
  "version": "1.3.4",
  "identifier": "com.cozy.reminder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "character",
        "url": "index.html",
        "width": 240,
        "height": 260,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Poltergeist",
        "width": 480,
        "height": 560,
        "minWidth": 440,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "todo",
        "url": "todo.html",
        "width": 220,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      },
      {
        "label": "calendar",
        "url": "calendar.html",
        "width": 300,
        "height": 440,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/findteemo/Poltergeist/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5MDE4NzIwNDQ3NjNFQgpSV1RyWTBjRWNoaVFCMUJPdFVSaUVMWlRPbDZydnRkcUxWcTVVVTV6TTlVRExRTmFkYkFETG5hbgo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"]
  }
}
